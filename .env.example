# Public Supabase project configuration (required for sign-in).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only credentials; never prefix with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_IMPORT_TOKEN=
CRON_SECRET=
CRON_SECRET_PREVIOUS=
