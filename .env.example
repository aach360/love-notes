# Optional nearby ticketed event source.
TICKETMASTER_API_KEY=

# Photon website settings. Use the same project/token in agent/.env.
PHOTON_PROJECT_ID=
PHOTON_BOT_ADDRESS=
PHOTON_AGENT_TOKEN=
