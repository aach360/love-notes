# Server-only secrets. Never prefix with VITE_.
ADMIN_IMPORT_TOKEN=change-me          # enables /admin "Refresh import"; unset = disabled
GEMINI_API_KEY=                       # optional: event tag/summary enrichment
ELEVENLABS_API_KEY=                   # optional: "Listen to my plan"
ELEVENLABS_VOICE_ID=                  # optional voice override
# Photon website settings; project secret belongs only in agent/.env.
PHOTON_PROJECT_ID=440f4b28-11a2-46d8-b24a-5dc0d7f5452f
PHOTON_BOT_ADDRESS=
PHOTON_AGENT_TOKEN=
# SUPABASE_URL= / SUPABASE_SERVICE_ROLE_KEY=  # when moving to database storage
# Optional: Ticketmaster Discovery API (nearby ticketed events). Absent = "unconfigured", no requests.
TICKETMASTER_API_KEY=
